include(BundleUtilities)
function(gp_item_default_embedded_path_override item path)
    set(${path} "@executable_path" PARENT_SCOPE)
endfunction()
set(BU_CHMOD_BUNDLE_ITEMS ON)
set(updater_root "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}/updater")
fixup_bundle("${updater_root}/beacon-updater" ""
    "$<TARGET_FILE_DIR:OpenSSL::Crypto>;$<TARGET_FILE_DIR:LibArchive::LibArchive>")
file(GLOB updater_links "${updater_root}/*.dylib")
foreach(link IN LISTS updater_links)
    if(IS_SYMLINK "${link}")
        file(REAL_PATH "${link}" target)
        set(copy "${link}.copy")
        file(COPY_FILE "${target}" "${copy}")
        file(REMOVE "${link}")
        file(RENAME "${copy}" "${link}")
    endif()
endforeach()
file(GLOB updater_libraries "${updater_root}/*.dylib")
foreach(binary IN LISTS updater_libraries)
    execute_process(COMMAND codesign --force --sign - "${binary}" COMMAND_ERROR_IS_FATAL ANY)
endforeach()
execute_process(COMMAND codesign --force --sign - "${updater_root}/beacon-updater" COMMAND_ERROR_IS_FATAL ANY)
