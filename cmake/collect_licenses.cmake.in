# Copies the license of every shared library bundled into the program or updater directory to
# <directory>/licenses/<package>/, looking it up where the library came from: vcpkg's port records, a Homebrew keg,
# the prefix a library was installed to, or the Debian package that owns it.
set(beacon_root "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}")
set(bundle_dirs "${beacon_root}/@BEACON_PROGRAM_DIR@" "${beacon_root}/updater")
set(search_dirs "@BEACON_LICENSE_SEARCH_DIRS@")
set(vcpkg_installed "@VCPKG_INSTALLED_DIR@")
set(vcpkg_triplet "@VCPKG_TARGET_TRIPLET@")
set(require_licenses @BEACON_REQUIRE_LICENSES@)

# Port names never contain '_', so a record <port>_<version>_<triplet>.list names its port up to the first '_'.
if(vcpkg_installed AND vcpkg_triplet AND IS_DIRECTORY "${vcpkg_installed}/vcpkg/info")
    file(GLOB records "${vcpkg_installed}/vcpkg/info/*_${vcpkg_triplet}.list")
    foreach(record IN LISTS records)
        get_filename_component(record_name "${record}" NAME)
        string(REGEX REPLACE "_.*" "" port "${record_name}")
        file(STRINGS "${record}" libraries REGEX "/(bin|lib)/[^/]+\\.(dll|dylib|so)(\\.[0-9]+)*$")
        foreach(library IN LISTS libraries)
            get_filename_component(library "${library}" NAME)
            string(TOLOWER "${library}" library)
            set("vcpkg_port_${library}" "${port}")
        endforeach()
    endforeach()
endif()

function(license_of name out_package out_files)
    set(package "")
    set(files "")
    string(TOLOWER "${name}" lower_name)
    if(DEFINED "vcpkg_port_${lower_name}")
        set(package "${vcpkg_port_${lower_name}}")
        set(files "${vcpkg_installed}/${vcpkg_triplet}/share/${package}/copyright")
    endif()
    if(NOT package)
        file(GLOB kegs "/opt/homebrew/opt/*/lib/${name}" "/usr/local/opt/*/lib/${name}")
        foreach(keg_library IN LISTS kegs)
            file(REAL_PATH "${keg_library}" real_library)
            get_filename_component(keg "${real_library}" DIRECTORY)
            get_filename_component(keg "${keg}" DIRECTORY)
            file(GLOB files "${keg}/LICENSE*" "${keg}/LICENCE*" "${keg}/COPYING*" "${keg}/NOTICE*")
            if(files)
                get_filename_component(package "${keg}" DIRECTORY)
                get_filename_component(package "${package}" NAME)
                break()
            endif()
        endforeach()
    endif()
    if(NOT package)
        foreach(directory IN LISTS search_dirs)
            if(EXISTS "${directory}/${name}")
                get_filename_component(prefix "${directory}" DIRECTORY)
                # A prefix can hold several packages; only one named in the library's own name is its license.
                file(GLOB license_dirs LIST_DIRECTORIES true "${prefix}/share/licenses/*")
                foreach(license_dir IN LISTS license_dirs)
                    get_filename_component(candidate "${license_dir}" NAME)
                    string(TOLOWER "${candidate}" lower_candidate)
                    string(FIND "${lower_name}" "${lower_candidate}" position)
                    file(GLOB files "${license_dir}/*")
                    if(files AND NOT position EQUAL -1)
                        set(package "${candidate}")
                        break()
                    endif()
                endforeach()
                if(package)
                    break()
                endif()
            endif()
        endforeach()
    endif()
    if(NOT package)
        find_program(dpkg dpkg)
        if(dpkg)
            execute_process(COMMAND "${dpkg}" -S "${name}" OUTPUT_VARIABLE owners ERROR_QUIET)
            string(REPLACE "\n" ";" owners "${owners}")
            foreach(owner IN LISTS owners)
                if(owner MATCHES "^([^:,]+)(:[^:]+)?: .*/([^/]+)$" AND CMAKE_MATCH_3 STREQUAL name)
                    set(package "${CMAKE_MATCH_1}")
                    set(files "/usr/share/doc/${package}/copyright")
                    break()
                endif()
            endforeach()
        endif()
    endif()
    set(existing "")
    foreach(file IN LISTS files)
        if(EXISTS "${file}")
            list(APPEND existing "${file}")
        endif()
    endforeach()
    if(NOT existing)
        set(package "")
    endif()
    set(${out_package} "${package}" PARENT_SCOPE)
    set(${out_files} "${existing}" PARENT_SCOPE)
endfunction()

set(missing "")
foreach(bundle_dir IN LISTS bundle_dirs)
    if(NOT IS_DIRECTORY "${bundle_dir}")
        continue()
    endif()
    file(GLOB libraries "${bundle_dir}/*.dll" "${bundle_dir}/*.dylib" "${bundle_dir}/*.so" "${bundle_dir}/*.so.*")
    foreach(library IN LISTS libraries)
        get_filename_component(name "${library}" NAME)
        license_of("${name}" package files)
        if(NOT package)
            list(APPEND missing "${library}")
            continue()
        endif()
        file(COPY ${files} DESTINATION "${bundle_dir}/licenses/${package}" FOLLOW_SYMLINK_CHAIN)
    endforeach()
endforeach()
if(missing)
    list(JOIN missing "\n  " missing)
    if(require_licenses)
        message(FATAL_ERROR "No license found for bundled libraries:\n  ${missing}")
    endif()
    message(WARNING "No license found for bundled libraries:\n  ${missing}")
endif()
